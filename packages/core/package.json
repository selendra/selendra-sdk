{
  "name": "@selendrajs/sdk",
  "version": "2.0.1",
  "description": "TypeScript SDK for interacting with the Selendra blockchain - Substrate, EVM, and unified accounts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./unified": {
      "import": "./dist/unified/index.js",
      "types": "./dist/unified/index.d.ts"
    },
    "./pallets/*": {
      "import": "./dist/pallets/*/index.js",
      "types": "./dist/pallets/*/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist docs/api",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selendra/selendra-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/selendra/selendra-sdk#readme",
  "bugs": {
    "url": "https://github.com/selendra/selendra-sdk/issues"
  },
  "keywords": [
    "blockchain",
    "substrate",
    "selendra",
    "sdk",
    "evm",
    "typescript",
    "react",
    "polkadot",
    "web3",
    "defi",
    "dapp"
  ],
  "author": "Selendra Team <info@selendra.org>",
  "license": "Apache-2.0",
  "dependencies": {
    "@polkadot/api": "^16.5.3",
    "@polkadot/keyring": "^13.5.9",
    "@polkadot/rpc-provider": "^16.5.3",
    "@polkadot/types": "^16.5.3",
    "@polkadot/util": "^13.5.9",
    "@polkadot/util-crypto": "^13.5.9",
    "@tanstack/react-query": "^5.62.0",
    "dotenv": "^16.6.1",
    "eventemitter3": "^5.0.1",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
